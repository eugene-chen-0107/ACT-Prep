# Copy to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. Use a private, TLS-enabled database in production.
DATABASE_URL=postgres://user:password@localhost:5432/act_prep

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Transactional email for verification and password reset (server-only).
# Configure a verified sending domain for production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Northstar ACT <accounts@your-verified-domain.example>

# Database-backed test suite uses a dedicated throwaway test database only.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/act_prep_test

# AI provider credentials (server-side only; not needed for the starter landing page)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
