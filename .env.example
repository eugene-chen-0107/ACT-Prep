# Copy to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (configured when database features are implemented)
DATABASE_URL=postgres://user:password@localhost:5432/act_prep

# Authentication secret (generate a unique, high-entropy value)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# AI provider credentials (server-side only; not needed for the starter landing page)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
