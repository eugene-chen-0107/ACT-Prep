# Copy to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. Use a private, TLS-enabled database in production.
DATABASE_URL=postgres://user:password@localhost:5432/act_prep

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=2fOBqynE5wW2j8m+L9kPvX1rA4s6tD7uV3yZ0eF1gH8=
BETTER_AUTH_URL=http://localhost:3000

# Transactional email for verification and password reset (server-only).
# Configure a verified sending domain for production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Northstar ACT <accounts@your-verified-domain.example>

# Database-backed test suite uses a dedicated throwaway test database only.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/act_prep_test

# Optional Grok answer-explanation provider credentials (server-side only).
# Explanations fall back to trusted question-bank content when the key is absent.
XAI_API_KEY=
XAI_EXPLANATION_MODEL=grok-4.7
# Optional dedicated model for original question generation and independent semantic review.
XAI_QUESTION_MODEL=grok-4.7
XAI_QUESTION_REVIEW_MODEL=grok-4.7
# Generation fails closed if the server-side reviewer is unavailable.
